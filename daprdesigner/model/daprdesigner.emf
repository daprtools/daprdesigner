@namespace(
	uri="http://dapr.io/daprtools/daprdesigner",
	prefix="daprdesigner")
package daprdesigner;


mapentry EStringToStringMapEntry : String -> String;

// Enums
enum AccessAction{
	ALLOW;
	DENY;
}

enum RetryPolicyType {
	CONSTANT;
	EXPONENTIAL;
	
}


enum HttpHandlerType{
	INCOMING;
	OUTGOING;
}

enum ResiliencyTargetType{
	APP=1;
	ACTOR=2;
	COMPONENT_INBOUND=3;
	COMPONENT_OUTBOUND=4;
	
}

enum BlockType{
	ENVIRONMENT;
	MICROSERVICES;
	PUBSUB;
	SECRETSTORE;
	BINDINGS;
	JOBS;
	WORKFLOW;
	ACTORS;
	STATESTORE;
	DISTRIBUTEDLOCK;
	CRYPTOGRAPHY;
	CONFIGURATION;
	CONFIGURATIONGROUP;		
}

enum NodeBlockType{
	APP;
	ACTOR;
	WORKFLOW;
	PUBSUB;
	BINDING;
	SECRETSTORE;
	STATESTORE;
	DISTRIBUTEDLOCK;
	CRYPTOGRAPHY;
	SUBSCRIPTION;
	RESILIENCY;
	HTTPENDPOINT;
	
	
}

enum APIType{
	
	INVOKE;
	STATE;
	PUBLISH;
	SUBSCRIBE;
	BINDINGS;
	SECRETS;
	ACTORS;
	METADATA;
	CONFIGURATION;
	LOCK;
	UNLOCK;
	CRYPTO;
	WORKFLOWS;
	HEALTHZ;
	SHUTDOWN;
	
}
enum SDKLanguage{
	JAVA;
	CSHARP;
	PYTHON;
	NODE;
	RUST;	
}

enum Protocol{
	HTTP;
	GRPC;
}

enum Verb{
	GET;
	POST;
	PUT;
	DELETE;
	PATCH;
}

// Base classes
class DaprArchitecture {
	attr String name;
	val Block[*] buildingblocks;
	
}

class Block{
	attr String name;
	attr String description;
	attr String notes;
	attr BlockType blockType;
	val Block[*] subblocks;
	val DaprNode[*] nodes;	
}

abstract class DaprNode{
	
	attr String name;
	attr String description;
	attr String notes;
	
}

class NodeBlocks extends DaprNode{
	
	attr NodeBlockType nodeBlockType;
	val DaprNode[*] nodes;	
	
}

class Namespace extends DaprNode{
	readonly attr String help = "https://docs.dapr.io/operations/components/component-scopes/";


	
	
}
class Trustdomain extends DaprNode{
	
	readonly attr String help = "https://docs.dapr.io/operations/configuration/invoke-allowlist/#trustdomain";
}



class App extends DaprNode{
	readonly attr String help = "https://docs.dapr.io/developing-applications/building-blocks/service-invocation/service-invocation-overview/";
	attr String appId;
	attr String repository;
	attr SDKLanguage sdkLanguage;
	ref Namespace namespace;
	ref Trustdomain trustDomain;
	ref AppConfiguration[*] configurations;
	
	
	
	
}

class Actor extends App{
  readonly attr String additionalHelp = "https://docs.dapr.io/developing-applications/building-blocks/actors/actors-overview/";
	
}

class Workflow extends App{

	readonly attr String additionalHelp = "https://docs.dapr.io/developing-applications/building-blocks/workflow/workflow-overview/";
	
	
}


abstract class AppConfiguration extends DaprNode{
	readonly attr String apiVersion = "dapr.io/v1alpha1";
	readonly attr String kind = "Configuration";
	
	
//	ref Namespace metadata_namespace;
//	ref AppAccessControl[0..1] accessControl;
//	ref APIAccessControl[0..1] apiControl;
//	ref MiddlewareConfiguration[0..1] middlewareConfiguration;
//	ref LoggingConfiguration[0..1] loggingConfiguration;
//	ref NameResolutionConfiguration[0..1] nameResolutionConfiguration;
//	ref SecretsAccessConfiguration[0..1] secretsAccessConfiguration;
//	ref MetricsConfiguration[0..1] metricsConfiguration;
//	ref TracingConfiguration[0..1] tracingConfiguration;
//	ref DeniedComponentsConfiguration[0..1] deniedComponentsConfiguration;
	
	
}

// Components Deny List
class DeniedComponentsConfiguration extends AppConfiguration{
	readonly attr String help = "https://docs.dapr.io/operations/configuration/configuration-overview/#disallow-usage-of-certain-component-types";
	ref Component[*] deniedComponents;
	

}



//Logging configuration
class LoggingConfiguration extends AppConfiguration{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/configuration-overview/#logging";
	attr boolean enabled = true;
	attr boolean obfuscateUrls = false;
	attr boolean omitHealthChecks = true;
	
}


//Name Resolution Configuration
class NameResolutionConfiguration extends AppConfiguration{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/configuration-overview/#name-resolution-component";
	ref Component component;
	attr String componentVersion;
	attr String configurationKey;
	attr String configurationValue;
	
	
}

//Secrets configuration
class SecretsAccessConfiguration extends AppConfiguration
{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/secret-scope/";
   	ref SecretsAccessList[*] accessList;
   
	
}

class SecretsAccessList extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/secret-scope/";
	ref Component component;
	attr boolean defaultAccess = true;
	attr String[*] secrets;
	attr AccessAction action;
	
	
}

// Metrics Configuration
class MetricsConfiguration extends AppConfiguration{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/configuration-overview/#metrics";
	attr boolean enabled;
	attr String latencyDistributionBuckets;
	attr boolean http_increasedCardinality;
	attr String[*] http_pathMatching;
	attr boolean http_excludeVerbs;
	
}

// API Configuration
class APIAccessControl extends AppConfiguration {
	readonly attr String help= "https://docs.dapr.io/operations/configuration/api-allowlist/#enabling-specific-http-apis";
	ref API[*] apiList;
	
}

class API extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/api-allowlist/#list-of-dapr-apis";
	attr APIType apiType;
	attr String api_version;
	attr Protocol protocol;
	attr AccessAction access;
	
}



// App AccessControl configuration
class AppAccessControl extends AppConfiguration {
	readonly attr String help= "https://docs.dapr.io/operations/configuration/invoke-allowlist/#access-control";
	attr AccessAction defaultAction;
	ref  Trustdomain trustDomain;
	ref AppPolicy[*] policies;
	
}



class AppPolicy extends DaprNode {
	readonly attr String help= "https://docs.dapr.io/operations/configuration/invoke-allowlist/#policies";
	ref App app;
	attr AccessAction defaultAction;
	ref Trustdomain trustDomain;
	ref Namespace namespace;
	ref Operation[*] operations;
}

class Operation extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/invoke-allowlist/#operations";
	attr Protocol protocol;
	attr String operationName;
    attr boolean applyToGet;
    attr boolean applyToPost;
    attr boolean applyToPut;
    attr boolean applyToDelete;
    attr boolean applyToPatch;
   // attr Verb[*] verbs;
	attr AccessAction action;
	
}

// Middleware Configuration
class MiddlewareConfiguration extends AppConfiguration{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/configuration-overview/#middleware";
	ref HttpHandler[*] httpHandlers;
	
}

class HttpHandler extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/configuration-overview/#middleware";
	attr String handlerName;
	attr String type;
	attr HttpHandlerType handlerType;
	
}


//Tracing Configuration
class TracingConfiguration extends AppConfiguration{
	readonly attr String help= "https://docs.dapr.io/operations/configuration/configuration-overview/#tracing";
	attr String samplingRate;
	attr boolean stdout;
	attr String otel_endPointAddress;
	attr boolean otel_isSecure;
	attr String otel_protocol;
	attr String zipkin_endPointAddress;
	
} 


// Subscription Configuration 
class SubscriptionConfiguration extends DaprNode {
	readonly attr String help= "https://docs.dapr.io/reference/resource-specs/subscription-schema/";
	readonly attr String apiVersion = "dapr.io/v2alpha1";
	readonly attr String kind = "Subscription";
	attr String topicName;
	ref RouteRules[*] routeRules;
	ref Component pubsub;
	attr String deadLetterTopic;
	attr boolean bulkSubscribe_enabled;
	attr String bulkSubscribe_maxMessagesCount;
	attr String bulkSubscribe_maxAwaitDurations;
	ref App[*] scopes;
	
	
}

class RouteRules extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/reference/resource-specs/subscription-schema/#spec-fields";
	attr String match;
	attr String path;
	
}


// Resiliency Configuration
class ResiliencyConfiguration extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/reference/resource-specs/resiliency-schema/";
	readonly attr String apiVersion = "dapr.io/v2alpha1";
	readonly attr String kind = "Resiliency";
	readonly attr String version = "v1alpha1";
	ref App[*] scopes;
	ref ResiliencyPolicy policy;
	ref ResiliencyTarget[*] resiliencyTargets;
}

class ResiliencyPolicy extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/operations/resiliency/policies/";
	ref RetryPolicy[*] retries;
	ref CircuitBreakerPolicy[*] circuitBreakers;
	ref ResiliencyTimeout[*] timeoutDefinitions;
	
	
}

class RetryPolicy extends DaprNode{
	
	readonly attr String help= "https://docs.dapr.io/operations/resiliency/policies/#retries";
	attr RetryPolicyType policy_type;
	attr int duration;
	attr int maxRetries;
	attr int maxInterval; 
	
	
}

class ResiliencyTimeout extends DaprNode{
	
	readonly attr String help= "https://docs.dapr.io/operations/resiliency/policies/#timeouts";
	attr int timeOutInSeconds;
	
	
}

class CircuitBreakerPolicy extends DaprNode{

	readonly attr String help= "https://docs.dapr.io/operations/resiliency/policies/#circuit-breakers";
	attr int maxRequests;
	attr int interval;
	attr int timeout;
	attr String trip = "consecutiveFailures > 5";
	
}

class ResiliencyTarget extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/operations/resiliency/targets/";
	attr ResiliencyTargetType type;
	attr int circuitBreakerCacheSize;
	ref CircuitBreakerPolicy[0..1] circuitBreaker;
	ref RetryPolicy[0..1] retry;
	ref ResiliencyTimeout[0..1] timeout;
	ref App[*] appsActorsOrWorkflows;
	ref Component[*] components;
	
	
	
}


// HTTPEndpoint Configuration

class HTTPEndPoint extends DaprNode {
	readonly attr String help= "https://docs.dapr.io/reference/resource-specs/httpendpoints-schema/"; 	
	readonly attr String apiVersion = "dapr.io/v1alpha1";
	readonly attr String kind = "HTTPEndpoint";
	attr String baseUrl;
	ref SecretStore auth;
	ref App[*] scopes;
	ref SpecMetadata[*] specHeaders; 
	ref SpecMetadata specRootCA; 
	ref SpecMetadata specCertificate; 
	ref SpecMetadata specPrivateKey;
	
}



//Component Definitions
abstract class Component extends DaprNode {
			
	readonly attr String apiVersion = "dapr.io/v1alpha1";
	readonly attr String kind = "Component";
	attr String providerName;
	ref SecretStore auth;
	ref Namespace metadata_namespace;
	ref ComponentSpec spec; 
	ref App[*] scopes;
	
	
		
}

class ComponentSpec extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/reference/resource-specs/component-schema/";
	attr boolean ignoreErrors;
	attr String initTimeout;
	ref SpecMetadata[*] specMetadata; 
}

class SpecMetadata extends DaprNode{
	readonly attr String help= "https://docs.dapr.io/reference/resource-specs/component-schema/#spec-fields";
	attr String value;
	attr boolean isFetchedFromSecret = false;
	attr boolean isFetchedFromEnvironment = false;
	attr String secretKeyRefName;
	attr String secretKeyRefKey;
	attr String envRef;
}




class PubSub extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-pubsub/";
	
}

class Bindings extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-bindings/";
	
	
}

class SecretStore extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-secret-stores/";
	
}


class StateStore extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-state-stores/";
	
}

class ConfigurationStore extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-configuration-stores/";
	
}

class Locks extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-locks/";
	
}

class Cryptography extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-cryptography/";
}

class Middleware extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-middleware/";
	
}
class Nameresolution extends Component{
	readonly attr String help= "https://docs.dapr.io/reference/components-reference/supported-name-resolution/";
	
}








